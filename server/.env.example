# ==============================================================================
# OneWinq Server — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ==============================================================================

# ---- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5173

# ---- MongoDB -----------------------------------------------------------------
# Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/onewinq?retryWrites=true&w=majority

# ---- JWT Secrets -------------------------------------------------------------
JWT_ACCESS_SECRET=your_access_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# ---- Cookies -----------------------------------------------------------------
COOKIE_SECRET=your_cookie_secret_min_32_chars
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
REFRESH_COOKIE_PATH=/api/v1/auth

# ---- CORS --------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Argon2id Password Hashing -----------------------------------------------
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# ---- OTP Settings ------------------------------------------------------------
OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS=5

# ---- Email (Google SMTP) -----------------------------------------------------
EMAIL_PROVIDER=smtp
EMAIL_FROM_ADDRESS=your-email@gmail.com
EMAIL_FROM_NAME=OneWinq

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your_16_char_google_app_password

# ---- Storage & Uploads (Cloudinary) ------------------------------------------
STORAGE_PROVIDER=cloudinary
STORAGE_LOCAL_DIR=uploads

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ---- Razorpay Payment Gateway (Optional) -------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Rate Limits -------------------------------------------------------------
RATE_LIMIT_GLOBAL_MAX=500
RATE_LIMIT_GLOBAL_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_OTP_MAX=5
RATE_LIMIT_OTP_WINDOW_MS=900000
RATE_LIMIT_SEARCH_MAX=60
RATE_LIMIT_SEARCH_WINDOW_MS=60000
RATE_LIMIT_UPLOAD_MAX=20
RATE_LIMIT_UPLOAD_WINDOW_MS=3600000

# ---- Data Retention ----------------------------------------------------------
NOTIFICATION_RETENTION_DAYS=30
ANALYTICS_RAW_RETENTION_DAYS=365
AUDIT_LOG_RETENTION_DAYS=730

# ---- Request Body & Logging --------------------------------------------------
REQUEST_BODY_LIMIT=1mb
LOG_LEVEL=info

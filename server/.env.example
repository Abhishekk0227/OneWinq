# ==============================================================================
# OneWinq Server — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env to version control.
# ==============================================================================

# Runtime Environment
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5173

# Database (MongoDB connection string)
MONGODB_URI=mongodb://localhost:27017/onewinq

# Authentication & Security (Secrets must be at least 32 characters long)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_long
JWT_REFRESH_EXPIRES_IN=7d

# Cookies & CORS
COOKIE_SECRET=your_cookie_secret_min_32_characters_long
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
REFRESH_COOKIE_PATH=/api/v1/auth
CORS_ORIGINS=http://localhost:5173

# Argon2 Password Hashing
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# OTP Settings
OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS=5

# Email Configuration
# Providers: 'console' | 'smtp' | 'sendgrid' | 'ses'
EMAIL_PROVIDER=console
EMAIL_FROM_ADDRESS=no-reply@onewinq.com
EMAIL_FROM_NAME=OneWinq

# SMTP (required if EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password

# SendGrid (optional, required if EMAIL_PROVIDER=sendgrid)
# SENDGRID_API_KEY=your_sendgrid_api_key

# AWS SES (optional, required if EMAIL_PROVIDER=ses)
# SES_REGION=us-east-1

# Media & Storage Configuration
# Providers: 'local' | 's3' | 'cloudinary'
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=uploads

# Cloudinary (required if STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AWS S3 (optional, required if STORAGE_PROVIDER=s3)
# S3_BUCKET=your_s3_bucket
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=your_aws_access_key
# S3_SECRET_ACCESS_KEY=your_aws_secret_key

# Razorpay Payments (optional)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Rate Limiting
RATE_LIMIT_GLOBAL_MAX=500
RATE_LIMIT_GLOBAL_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_OTP_MAX=5
RATE_LIMIT_OTP_WINDOW_MS=900000
RATE_LIMIT_SEARCH_MAX=60
RATE_LIMIT_SEARCH_WINDOW_MS=60000
RATE_LIMIT_UPLOAD_MAX=20
RATE_LIMIT_UPLOAD_WINDOW_MS=3600000

# Data Retention & Request Limits
NOTIFICATION_RETENTION_DAYS=30
ANALYTICS_RAW_RETENTION_DAYS=365
AUDIT_LOG_RETENTION_DAYS=730
REQUEST_BODY_LIMIT=1mb
LOG_LEVEL=info
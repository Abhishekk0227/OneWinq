# ==============================================================================
# OneWinq Server — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ==============================================================================

# ---- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=5000

# ---- MongoDB -----------------------------------------------------------------
# Local:   mongodb://127.0.0.1:27017/onewinq
# Atlas:   mongodb+srv://user:pass@cluster.mongodb.net/onewinq
MONGODB_URI=mongodb://127.0.0.1:27017/onewinq

# ---- JWT ---------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# ---- Cookies -----------------------------------------------------------------
COOKIE_SECRET=CHANGE_ME_cookie_secret_min_32_chars
# Set COOKIE_SECURE=true in production (requires HTTPS)
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Restrict refresh-token cookie to the token refresh path
REFRESH_COOKIE_PATH=/api/v1/auth

# ---- CORS --------------------------------------------------------------------
# Comma-separated list of allowed origins (no wildcards)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Argon2id ----------------------------------------------------------------
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# ---- OTP ---------------------------------------------------------------------
OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS=5

# ---- Email -------------------------------------------------------------------
# Providers: console | sendgrid | ses | smtp
EMAIL_PROVIDER=console
EMAIL_FROM_ADDRESS=no-reply@onewinq.com
EMAIL_FROM_NAME=OneWinq

# SendGrid (if EMAIL_PROVIDER=sendgrid)
# SENDGRID_API_KEY=

# SMTP (if EMAIL_PROVIDER=smtp)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# AWS SES (if EMAIL_PROVIDER=ses)
# SES_REGION=ap-south-1

# ---- Cloudinary --------------------------------------------------------------
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ---- Razorpay ----------------------------------------------------------------
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# ---- Rate Limits -------------------------------------------------------------
RATE_LIMIT_GLOBAL_MAX=500
RATE_LIMIT_GLOBAL_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_OTP_MAX=5
RATE_LIMIT_OTP_WINDOW_MS=900000
RATE_LIMIT_SEARCH_MAX=60
RATE_LIMIT_SEARCH_WINDOW_MS=60000
RATE_LIMIT_UPLOAD_MAX=20
RATE_LIMIT_UPLOAD_WINDOW_MS=3600000

# ---- Data Retention ----------------------------------------------------------
NOTIFICATION_RETENTION_DAYS=30
ANALYTICS_RAW_RETENTION_DAYS=365
AUDIT_LOG_RETENTION_DAYS=730

# ---- Request Body ------------------------------------------------------------
REQUEST_BODY_LIMIT=1mb

# ---- Logging -----------------------------------------------------------------
# error | warn | info | http | debug
LOG_LEVEL=info
